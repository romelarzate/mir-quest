# MIR Quest - variables de entorno (solo nombres, sin valores)
# Copia este archivo a .env.local y rellena los valores en local.
# NUNCA subas valores reales al repositorio ni los guardes en localStorage.

# --- Fase 5: recuperación documental (Gemini File Search) ---
# Clave de API del proveedor. Se gestiona fuera del repositorio.
VITE_DOCUMENT_PROVIDER=
VITE_GEMINI_API_KEY=
VITE_GEMINI_FILE_SEARCH_STORE=

# --- Fase 5: generación de contenido ---
VITE_GENERATION_PROVIDER=
VITE_GENERATION_MODEL=

# --- Modo de ejecución ---
# mock | real . En esta fase solo se admite mock.
VITE_DOCUMENT_MODE=
